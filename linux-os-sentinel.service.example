[Unit]
Description=Linux OS Sentinel (passive system and Tor process monitoring)
After=local-fs.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER
ExecStart=/usr/bin/python3 /home/YOUR_USER/linux-os-sentinel.py --interval 2 --interface auto --metrics-probe-interval 60
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
