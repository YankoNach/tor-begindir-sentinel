[Unit]
Description=Tor BEGIN_DIR Storm Sentinel
After=network-online.target tor@default.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER
ExecStart=/usr/bin/python3 /home/YOUR_USER/tor-begindir-sentinel.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
